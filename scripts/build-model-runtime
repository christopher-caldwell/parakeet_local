#!/bin/sh
set -eu
mkdir -p target/native
# Skip the compile when the helper is newer than its sources and this script.
if [ -x target/native/parakeet-model-runtime ] && [ -z "$(find native/fluidaudio native/asr.swift native/model-runtime.swift "$0" -newer target/native/parakeet-model-runtime)" ]; then
  exit 0
fi
parakeet_output="target/native/.parakeet-model-runtime-build-$$"
parakeet_log="$parakeet_output.log"
trap 'rm -f "$parakeet_output" "$parakeet_log"' EXIT HUP INT TERM
# The vendored FluidAudio code triggers many deprecation warnings; show compiler output only on failure.
if ! swiftc -swift-version 5 -parse-as-library -D Diarizer -O native/fluidaudio/*.swift native/asr.swift native/model-runtime.swift -framework CoreML -framework Accelerate -framework AVFoundation -o "$parakeet_output" >"$parakeet_log" 2>&1; then
  cat "$parakeet_log" >&2
  exit 1
fi

mv -f "$parakeet_output" target/native/parakeet-model-runtime
