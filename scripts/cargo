#!/bin/sh
set -eu
# Homebrew cargo otherwise finds an older Homebrew rustc before rustup's toolchain.
toolchain_bin=$(dirname "$(rustup which --toolchain 1.99.1 cargo)")
# Some command-line tools installs leave the C++ standard library headers only inside the SDK,
# which breaks the whisper.cpp build ('mutex' file not found). Point the compiler at them.
cxx_headers="$(xcrun --show-sdk-path)/usr/include/c++/v1"
if [ -z "${CPLUS_INCLUDE_PATH:-}" ] && [ -d "$cxx_headers" ]; then
  export CPLUS_INCLUDE_PATH="$cxx_headers"
fi
PATH="$toolchain_bin:$PATH" exec "$toolchain_bin/cargo" "$@"
