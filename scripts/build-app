#!/bin/sh
set -eu
build_profile=debug
build_release=
build_features=
for option in "$@"; do
  case "$option" in
    --release) build_profile=release; build_release=--release ;;
    --performance) build_features=--features=parakeet-desktop/performance ;;
    *) echo "Usage: scripts/build-app [--release] [--performance]" >&2; exit 2 ;;
  esac
done
scripts/cargo build --quiet -p parakeet-cli -p parakeet-desktop $build_release $build_features
scripts/build-native
scripts/build-model-runtime
bundle='target/Parakeet Local.app'
mkdir -p "$bundle/Contents/MacOS" "$bundle/Contents/Resources"
cp "target/$build_profile/parakeet-desktop" "$bundle/Contents/MacOS/.ParakeetLocal.new"
mv -f "$bundle/Contents/MacOS/.ParakeetLocal.new" "$bundle/Contents/MacOS/ParakeetLocal"
cp target/native/parakeet-bridge "$bundle/Contents/MacOS/parakeet-bridge"
cp target/native/parakeet-model-runtime "$bundle/Contents/MacOS/parakeet-model-runtime"
cat > "$bundle/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleIdentifier</key><string>dev.caldwell.parakeet-local</string>
<key>CFBundleName</key><string>Parakeet Local</string>
<key>CFBundleExecutable</key><string>ParakeetLocal</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleVersion</key><string>1</string>
<key>CFBundleShortVersionString</key><string>0.1.0</string>
<key>LSMinimumSystemVersion</key><string>14.0</string>
<key>NSMicrophoneUsageDescription</key><string>Record speech locally from your explicitly selected microphone.</string>
<key>NSHighResolutionCapable</key><true/>
</dict></plist>
PLIST
# Finder can add this metadata after opening the generated bundle, and codesign
# refuses it on the next build. Restrict cleanup to these non-security attributes
# inside our build product; preserve provenance and quarantine attributes.
python3 - "$bundle" <<'PY'
import subprocess, sys
from pathlib import Path
bundle = Path(sys.argv[1])
for item in [bundle, *bundle.rglob('*')]:
    if item.is_symlink():
        continue
    attributes = subprocess.check_output(['/usr/bin/xattr', str(item)], text=True).splitlines()
    for attribute in ('com.apple.FinderInfo', 'com.apple.ResourceFork'):
        if attribute in attributes:
            subprocess.run(['/usr/bin/xattr', '-d', attribute, str(item)], check=True)
PY
codesign --force --deep --sign - "$bundle" 2>/dev/null
