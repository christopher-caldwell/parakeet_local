#!/bin/sh
set -eu
mkdir -p target/native
parakeet_output="target/native/.parakeet-bridge-build-$$"
parakeet_log="$parakeet_output.log"
trap 'rm -f "$parakeet_output" "$parakeet_log"' EXIT HUP INT TERM
if ! swiftc -parse-as-library -O native/bridge.swift native/clipboard.swift -o "$parakeet_output" -framework AVFoundation -framework AudioToolbox -framework CoreAudio -framework ScreenCaptureKit -framework AppKit -framework ApplicationServices >"$parakeet_log" 2>&1; then
  cat "$parakeet_log" >&2
  exit 1
fi

mv -f "$parakeet_output" target/native/parakeet-bridge
